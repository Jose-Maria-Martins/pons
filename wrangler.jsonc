{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pons",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Keep pons.jose-maria-martins.workers.dev working next to the custom domain.
  "workers_dev": true,
  // The landing page. A request that matches a file in site/ gets that file; every other path runs the Worker.
  "assets": { "directory": "./site/" },
  // nodejs_compat: the agents package needs node:async_hooks.
  // global_fetch_strictly_public: lets the OAuth library fetch client metadata documents.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Bundle PNG files as binary modules (the icon is served from the Worker).
  "rules": [{ "type": "Data", "globs": ["**/*.png"], "fallthrough": true }],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "6d16409b04594516911af344eacee52f"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      // Cloudflare's rate-limit binding only allows a period of 10 or 60 seconds.
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "TOOL_LIMIT",
      "namespace_id": "1002",
      // Per user, approximate and per Cloudflare location: a guard against runaway loops, not an exact quota.
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "analytics_engine_datasets": [{ "binding": "PONS_EVENTS", "dataset": "pons_events" }],
  "vars": {
    // Public Turnstile site key for the "Pons" widget. Local dev overrides it with the test key in .dev.vars.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFhBVqnm5x2-CpZb",
    // Public URL of the source code, for the /privacy page (for example https://github.com/<owner>/<repo>). Empty: no link.
    "SOURCE_URL": ""
  },
  "observability": { "enabled": true }
}
